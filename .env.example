# Google Gemini API configuration
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model selection
# Free-tier Flash model recommendation (e.g., gemini-1.5-flash or gemini-2.0-flash)
# Checked: October 2026
GEMINI_MODEL=gemini-2.0-flash

# Database configuration (defaults to SQLite in data/business.db)
DATABASE_URL=sqlite:///data/business.db

# Embedding configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Rate Limiter & Pipeline configuration
REQUESTS_PER_MINUTE=15
MAX_REPAIR_ATTEMPTS=2
ENABLE_NL_EXPLANATION=true
MAX_EXECUTION_ROWS=100
QUERY_TIMEOUT_SECONDS=10

# Optional LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nl2sql-agent

